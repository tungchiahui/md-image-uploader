{
  "name": "md-image-uploader",
  "displayName": "MD Image Uploader",
  "description": "Upload pasted Markdown images to S3-compatible object storage.",
  "version": "0.0.4",
  "publisher": "tungchiahui",
  "repository": {
    "type": "git",
    "url": "https://github.com/tungchiahui/md-image-uploader.git"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:mdImageUploader.testUpload"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "mdImageUploader.testUpload",
        "title": "Test Upload",
        "category": "MD Image Uploader"
      }
    ],
    "configuration": {
      "title": "MD Image Uploader",
      "properties": {
        "mdImageUploader.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable MD Image Uploader for this resource."
        },
        "mdImageUploader.s3.endpoint": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional S3-compatible API endpoint. Leave empty to use the AWS S3 endpoint for the configured region."
        },
        "mdImageUploader.s3.region": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "AWS or S3-compatible service region."
        },
        "mdImageUploader.s3.bucket": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Destination S3 bucket."
        },
        "mdImageUploader.s3.accessKeyId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "S3 access key ID. Store credentials in User Settings and do not commit them to a shared `.vscode/settings.json`."
        },
        "mdImageUploader.s3.secretAccessKey": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "S3 secret access key. Store credentials in User Settings and do not commit them to a shared `.vscode/settings.json`."
        },
        "mdImageUploader.s3.forcePathStyle": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Use path-style S3 URLs instead of virtual-hosted-style URLs."
        },
        "mdImageUploader.datedUploadPath": {
          "type": "string",
          "default": "markdown",
          "scope": "resource",
          "description": "Object key prefix used when the Markdown path contains a valid date."
        },
        "mdImageUploader.undatedUploadPath": {
          "type": "string",
          "default": "misc",
          "scope": "resource",
          "description": "Object key prefix used when the Markdown path does not contain a valid date."
        },
        "mdImageUploader.cdnUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Public HTTP or HTTPS base URL used for generated Markdown image links."
        },
        "mdImageUploader.webp.quality": {
          "type": "number",
          "default": 85,
          "minimum": 1,
          "maximum": 100,
          "scope": "resource",
          "description": "WebP output quality from 1 to 100."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "lint": "eslint src test scripts",
    "test": "npm run compile && node --test test/*.test.js",
    "package:vsix": "vsce package --target linux-x64 --allow-missing-repository --out md-image-uploader-linux-x64.vsix",
    "verify:vsix": "node scripts/verifyVsix.js md-image-uploader-linux-x64.vsix",
    "verify:installed-vsix": "node scripts/verifyInstalledVsix.js md-image-uploader-linux-x64.vsix",
    "test:vsix": "npm run package:vsix && npm run verify:vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vscode/vsce": "^3.9.2",
    "adm-zip": "^0.5.18",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@img/sharp-wasm32": "0.35.3",
    "sharp": "0.35.3"
  }
}
